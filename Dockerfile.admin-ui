# Dockerfile para Admin UI (Next.js + standalone output).
# Roda em :9091, nao-root (uid 10000).
#
# Build:
#   docker build -t fluxa-admin-ui -f Dockerfile.admin-ui .
#
# Rodar:
#   docker run --rm -p 9091:9091 fluxa-admin-ui
#   # ou com env custom:
#   docker run --rm -p 9091:9091 -e PORT=9091 \
#     -e NEXT_PUBLIC_FLUXA_API_URL=https://api.fluxa.example \
#     fluxa-admin-ui

# ── Deps ─────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/admin-ui/package.json ./apps/admin-ui/
COPY packages ./packages

RUN pnpm install --frozen-lockfile

# ── Build ────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

ENV CI=true
ENV PNPM_CONFIRM_MODULES_PURGE=false

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY --from=deps /app/ ./
COPY . .

# Builda o app (next.config.mjs tem output: 'standalone' para Docker).
RUN pnpm --filter @fluxa/admin-ui build

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime

ENV NODE_ENV=production
ENV PORT=9091

# O Next standalone gera apps/admin-ui/.next/standalone com a mesma
# estrutura do agent-ui (server.js + .next/ + node_modules + public/).
WORKDIR /app

# Copia o servidor standalone do Next (entrypoint principal).
COPY --from=builder /app/apps/admin-ui/.next/standalone ./
# Copia o build output (.next) e os estaticos (public).
COPY --from=builder /app/apps/admin-ui/.next/static ./apps/admin-ui/.next/static
COPY --from=builder /app/apps/admin-ui/public ./apps/admin-ui/public

# Usuario nao-root (uid alto pra evitar conflito com usuario node:alpine).
RUN apk add --no-cache shadow && \
    addgroup -g 10000 fluxa && adduser -D -G fluxa -u 10000 fluxa && \
    chown -R fluxa:fluxa /app
USER fluxa

EXPOSE 9091

CMD ["node", "apps/admin-ui/server.js"]