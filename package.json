{
  "name": "fluxa-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Repositorio unico de UI do Fluxa (monorepo): Agent UI + Admin UI",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:agent": "turbo run dev --filter=@fluxa/agent-ui",
    "dev:admin": "turbo run dev --filter=@fluxa/admin-ui",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines.node": ">=20.0.0"
}
