{
  "name": "@fluxa/plugin-chat-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin demonstrativo de chat (conversa cliente × atendente) para o Agent UI",
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "next build",
    "build:bundle": "esbuild src/panels/index.ts --bundle --format=esm --outfile=public/chat.mjs --jsx=transform --jsx-factory=globalThis.__FLUXA_REACT__.createElement --jsx-fragment=globalThis.__FLUXA_REACT__.Fragment --log-level=warning",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests yet' && exit 0"
  },
  "dependencies": {
    "@fluxa/plugin-sdk": "workspace:*",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
