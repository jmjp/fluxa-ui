# Build-time env vars for Agent UI production image.
# Next.js bakes NEXT_PUBLIC_* into the client bundle at build time,
# so values here become part of the JS the browser downloads.
#
# Source of truth: the runtime FQDN of the Fluxa core service as exposed
# by Dokploy/Traefik. Keep in sync with the URL the Agent UI should call.

NEXT_PUBLIC_FLUXA_API_URL=http://localhost:8080
NEXT_PUBLIC_BUILD_TIME=2026-08-25T00:10:00Z