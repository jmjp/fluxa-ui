{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@fluxa/shared": ["../../packages/shared/src/index.ts"],
      "@fluxa/shared/api": ["../../packages/shared/src/api/client.ts"],
      "@fluxa/shared/types/*": ["../../packages/shared/src/types/*"],
      "@fluxa/shared/*": ["../../packages/shared/src/*"],
      "@fluxa/ui": ["../../packages/ui/src/index.ts"],
      "@fluxa/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
